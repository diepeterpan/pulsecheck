mns/><plot_y_axes/><global_filter/></table></browse_table_settings></tab_browse><tab_sql><sql name="SQL 1*">        WITH latest AS (
            SELECT service_id, port, is_online, status, last_response_ms, checked_at,
                   ROW_NUMBER() OVER (PARTITION BY service_id, port ORDER BY checked_at DESC) AS rn
            FROM port_checks
        )
         SELECT s.id, s.name, s.match, s.ports, latest.port, latest.is_online,
             COALESCE(latest.status, CASE WHEN latest.is_online = 1 THEN 'online' ELSE 'offline' END) AS status,
             latest.last_response_ms, latest.checked_at
        FROM services s
        LEFT JOIN latest ON latest.service_id = s.id AND latest.rn = 1 AND instr(s.ports, port) &gt; 0
        WHERE s.paused = 0
        ORDER BY s.name, latest.port</sql><current_tab id="0"/></tab_sql></sqlb_project>
