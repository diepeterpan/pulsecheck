# ==============================================================================
# PulseCheck - Development OIDC Environment Configuration Template
# ==============================================================================
# Copy this file to '.env.oidc' and fill in your OIDC provider credentials.
# Then run: ./run_dev_oidc.sh
# ==============================================================================

# Master OIDC switch: set to 'true' to enable authentication & authorization
PULSECHECK_OIDC_ENABLED=true

# OIDC Discovery / Issuer URL (Authelia, Keycloak, Authentik, etc.)
# Examples:
#   Authelia:  https://auth.example.com
#   Keycloak:  https://keycloak.example.com/realms/myrealm
#   Authentik: https://authentik.example.com/application/o/pulsecheck/
PULSECHECK_OIDC_ISSUER="https://auth.example.com"

# Registered Client ID in your OIDC provider
PULSECHECK_OIDC_CLIENT_ID="pulsecheck-dev"

# Registered Client Secret in your OIDC provider
PULSECHECK_OIDC_CLIENT_SECRET="replace-with-client-secret"

# Redirect callback URI (defaults to http://127.0.0.1:8182/auth/callback)
PULSECHECK_OIDC_REDIRECT_URI="http://127.0.0.1:8182/auth/callback"

# Scopes requested during login
PULSECHECK_OIDC_SCOPES="openid email profile"

# OIDC Claim key to match against PulseCheck Authorized Users
# Supported: 'email' (default), 'preferred_username', 'sub'
PULSECHECK_OIDC_MATCH_CLAIM="email"

# Initial admin identifier to auto-provision into database if table is empty
# This prevents lockout when first booting with OIDC enabled
PULSECHECK_OIDC_INITIAL_ADMIN="admin@example.com"

# Flask session secret key for local development
PULSECHECK_SECRET_KEY="pulsecheck-dev-secret-key-change-me"

# Optional local network binding
PULSECHECK_IP="0.0.0.0"
PULSECHECK_HOSTNAME="127.0.0.1"
PULSECHECK_PORT="8182"
PULSECHECK_SSL="FALSE"
PULSECHECK_HEADLESS="1"
